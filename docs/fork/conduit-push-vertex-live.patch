+# --- Vertex AI provider (local patch) -------------------------------------
+# Set CONDUIT_GEMINI_LIVE_PROVIDER=vertex and point
+# CONDUIT_GEMINI_LIVE_VERTEX_CREDENTIALS at a service-account key to serve
+# Gemini Live from Vertex AI instead of AI Studio. The phone gets a short-lived
+# OAuth access token for that service account (Vertex has no Live-only
+# ephemeral tokens), so the account should hold as few roles as possible.
+PROVIDER_ENV_VAR = "CONDUIT_GEMINI_LIVE_PROVIDER"
+VERTEX_CREDENTIALS_ENV_VAR = "CONDUIT_GEMINI_LIVE_VERTEX_CREDENTIALS"
+VERTEX_LOCATION_ENV_VAR = "CONDUIT_GEMINI_LIVE_VERTEX_LOCATION"
+VERTEX_DEFAULT_LOCATION = "us-central1"  # Live models are not served from "global"
+VERTEX_SCOPE = "https://www.googleapis.com/auth/cloud-platform"
+VERTEX_TOKEN_MARGIN_S = 300
+
+
+def is_vertex(get_env: Optional[Callable[[str], Optional[str]]] = None) -> bool:
+    get_env = get_env or _env_value
+    return str(get_env(PROVIDER_ENV_VAR) or "").strip().lower() == "vertex"
+
+
+def resolve_vertex_credentials(get_env: Optional[Callable[[str], Optional[str]]] = None) -> Optional[str]:
+    get_env = get_env or _env_value
+    for name in (VERTEX_CREDENTIALS_ENV_VAR, "VERTEX_CREDENTIALS_PATH", "GOOGLE_APPLICATION_CREDENTIALS"):
+        value = str(get_env(name) or "").strip()
+        if value and os.path.isfile(os.path.expanduser(value)):
+            return os.path.expanduser(value)
+    return None
+
+
+def vertex_location(get_env: Optional[Callable[[str], Optional[str]]] = None) -> str:
+    get_env = get_env or _env_value
+    return str(get_env(VERTEX_LOCATION_ENV_VAR) or "").strip() or VERTEX_DEFAULT_LOCATION
+
+
+def vertex_websocket_url(location: str) -> str:
+    return (
+        f"wss://{location}-aiplatform.googleapis.com/ws/"
+        "google.cloud.aiplatform.v1.LlmBidiService/BidiGenerateContent"
+    )
+
+
+def _b64url(data: bytes) -> bytes:
+    return base64.urlsafe_b64encode(data).rstrip(b"=")
+
+
+def _mint_vertex_access_token(sa: Dict[str, Any], now: float) -> tuple:
+    """Exchange a service-account key for an access token (stdlib + openssl).
+
+    Hermes' bundled Python has no google-auth, so the RS256 JWT is signed with
+    the system ``openssl`` binary.
+    """
+    header = _b64url(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
+    claims = _b64url(json.dumps({
+        "iss": sa["client_email"], "scope": VERTEX_SCOPE, "aud": sa["token_uri"],
+        "iat": int(now), "exp": int(now) + 3600,
+    }).encode())
+    signing_input = header + b"." + claims
+    fd, key_path = tempfile.mkstemp()
+    try:
+        os.chmod(key_path, 0o600)
+        with os.fdopen(fd, "w") as handle:
+            handle.write(sa["private_key"])
+        signature = subprocess.run(
+            ["openssl", "dgst", "-sha256", "-sign", key_path],
+            input=signing_input, capture_output=True, check=True, timeout=10,
+        ).stdout
+    finally:
+        os.unlink(key_path)
+    form = urllib.parse.urlencode({
+        "grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer",
+        "assertion": (signing_input + b"." + _b64url(signature)).decode(),
+    }).encode()
+    request = urllib.request.Request(sa["token_uri"], data=form)
+    with urllib.request.urlopen(request, timeout=REQUEST_TIMEOUT_S) as response:
+        payload = json.load(response)
+    return payload["access_token"], int(payload.get("expires_in", 3600))
+
+
+_vertex_token_cache: Dict[str, Any] = {}
+_vertex_token_lock = threading.Lock()
+
+
+def vertex_access_token(credentials_path: str, now: Optional[float] = None) -> tuple:
+    """Cached access token (reused until shortly before expiry) and its expiry epoch."""
+    now = time.time() if now is None else now
+    with _vertex_token_lock:
+        cached = _vertex_token_cache.get(credentials_path)
+        if cached and cached["expires"] - VERTEX_TOKEN_MARGIN_S > now:
+            return cached["token"], cached["expires"]
+        with open(credentials_path) as handle:
+            sa = json.load(handle)
+        try:
+            token, ttl = _mint_vertex_access_token(sa, now)
+        except (subprocess.SubprocessError, urllib.error.URLError, KeyError, OSError) as exc:
+            raise TokenError(502, f"Could not get a Vertex AI access token: {type(exc).__name__}") from exc
+        _vertex_token_cache[credentials_path] = {"token": token, "expires": now + ttl}
+        return token, now + ttl
+
+
+def mint_vertex_live_token(
+    get_env: Optional[Callable[[str], Optional[str]]] = None,
+    now: Optional[datetime] = None,
+    limiter_key: Optional[str] = None,
+) -> Dict[str, Any]:
+    get_env = get_env or _env_value
+    credentials = resolve_vertex_credentials(get_env)
+    if credentials is None:
+        raise TokenError(503, "Vertex AI credentials are not configured on this Hermes host")
+    if limiter_key is not None:
+        _mint_limiter.acquire(limiter_key)
+    with open(credentials) as handle:
+        project = json.load(handle).get("project_id")
+    if not project:
+        raise TokenError(503, "The Vertex AI credentials file has no project_id")
+    location = vertex_location(get_env)
+    model = resolve_model(get_env)
+    token, expires = vertex_access_token(credentials, now.timestamp() if now else None)
+    expires_at = _timestamp(datetime.fromtimestamp(expires, timezone.utc))
+    return {
+        "token": token,
+        "expires_at": expires_at,
+        "new_session_expires_at": expires_at,
+        "model": f"projects/{project}/locations/{location}/publishers/google/models/{model}",
+        "websocket_url": vertex_websocket_url(location),
+    }
+
+
 def _timestamp(value: datetime) -> str:
     return value.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
 
